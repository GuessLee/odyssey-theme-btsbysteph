---
const {post} = Astro.props;
---

<li class="blog-post__preview">
  <a href={post.href}>
    <div class="blog-warm-image blog-post__preview-img">
      <img src={post.featuredImage} alt={post.title} />
    </div>
    <div class="blog-post__preview-body">
      <h3>{post.title}</h3>
      {post.excerpt && <p>{post.excerpt}</p>}
      <span class="blog-post__preview-cta">Read the story &rarr;</span>
    </div>
  </a>
</li>


<style>
.blog-post__preview {
  background: var(--blog-surface);
  border-radius: var(--blog-radius);
  box-shadow: var(--blog-card-shadow);
  overflow: hidden;
}
.blog-post__preview-img {
  aspect-ratio: 16 / 9;
  border-radius: 0;
  /* Card already has --blog-card-shadow; skip image-level --blog-image-glow to avoid double shadow. */
  box-shadow: none;
  transition: transform var(--theme-transition);
}
.blog-post__preview:hover .blog-post__preview-img {
  transform: scale(1.01);
}
.blog-post__preview a {
  display: block;
  text-decoration: none;
  color: inherit;
}
.blog-post__preview-body {
  padding: 1rem 1.25rem 1.25rem;
}
.blog-post__preview h3 {
  margin: 0 0 0.5rem;
}
.blog-post__preview p {
  color: var(--theme-on-surface-1);
}
.blog-post__preview-cta {
  display: inline-block;
  margin-top: 0.5rem;
  font-family: var(--theme-font-family-sans);
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--blog-accent-text);
}
</style>
