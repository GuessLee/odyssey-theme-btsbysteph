---
const {post} = Astro.props;
---

<li class="blog-post__preview">
  <a href={post.href}>
    <div class="blog-warm-image blog-post__preview-img">
      <img src={post.featuredImage} alt={post.title} />
    </div>
    <h3>{post.title}</h3>
    {post.excerpt && <p>{post.excerpt}</p>}
    <span class="blog-post__preview-cta">Read the story &rarr;</span>
  </a>
</li>


<style>
.blog-post__preview-img {
  margin-bottom: 1rem;
  aspect-ratio: 4 / 3;
  transition: transform var(--theme-transition);
}
.blog-post__preview:hover .blog-post__preview-img {
  transform: scale(1.01);
}
.blog-post__preview a {
  display: block;
  text-decoration: none;
  color: inherit;
}
.blog-post__preview h3 {
  margin: 0 0 0.25rem;
}
.blog-post__preview-cta {
  display: inline-block;
  margin-top: 0.5rem;
  font-family: var(--theme-font-family-sans);
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--blog-highlight-deep);
}
</style>
