---
// One 9:16 tile of footage. Shows a cover image only; the video itself is
// fetched by ClipViewer when the tile is tapped.
import { Image } from 'astro:assets';

const covers = import.meta.glob('../../assets/clips/*.jpg', {
	eager: true,
	import: 'default',
});

const { tile, caption = true, eager = false, sizes } = Astro.props;

const cover = covers[`../../assets/clips/${tile.cover}.jpg`];
if (!cover) {
	throw new Error(
		`ClipTile: no cover image at src/assets/clips/${tile.cover}.jpg`
	);
}
---

<button
	class="clip-tile"
	type="button"
	data-clip-tile
	data-clip-src={tile.src}
	data-clip-start={tile.start}
	data-clip-label={tile.label}
	data-clip-moment={tile.moment}
	data-clip-wedding={tile.wedding || undefined}
	aria-label={`Play: ${tile.label}`}
>
	<Image
		src={cover}
		alt=""
		widths={[270, 405, 540]}
		sizes={sizes}
		loading={eager ? 'eager' : 'lazy'}
	/>
	{caption && <span class="clip-tile__label">{tile.label}</span>}
	<span class="clip-tile__play" aria-hidden="true">
		<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
	</span>
</button>

<style>
	.clip-tile {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 9 / 16;
		padding: 0;
		border: 0;
		border-radius: var(--theme-radius-lg);
		overflow: hidden;
		background: var(--theme-accent-dark);
		box-shadow: var(--theme-image-glow);
		cursor: pointer;
		text-align: left;
		transition:
			transform var(--theme-transition),
			box-shadow var(--theme-transition);
	}

	.clip-tile:hover {
		transform: translateY(-6px);
		box-shadow: 0 22px 44px -16px rgba(181, 119, 46, 0.5);
	}

	.clip-tile[hidden] {
		display: none;
	}

	.clip-tile :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Darken the foot of the cover so the label stays readable on any frame. */
	.clip-tile::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			transparent 55%,
			rgba(30, 18, 6, 0.78) 100%
		);
		pointer-events: none;
	}

	.clip-tile__label {
		position: absolute;
		left: 0.8rem;
		right: 0.8rem;
		bottom: 0.75rem;
		z-index: 1;
		color: #fff;
		font-family: var(--theme-font-family-serif);
		font-size: 1.1rem;
		font-weight: 500;
		line-height: 1.15;
	}

	.clip-tile__play {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1;
		width: 46px;
		height: 46px;
		margin: -23px 0 0 -23px;
		border-radius: 50%;
		background: rgba(255, 250, 247, 0.92);
		display: grid;
		place-items: center;
		opacity: 0;
		transition: opacity var(--theme-transition);
	}

	.clip-tile:hover .clip-tile__play,
	.clip-tile:focus-visible .clip-tile__play {
		opacity: 1;
	}

	.clip-tile__play svg {
		width: 18px;
		height: 18px;
		margin-left: 3px;
		fill: var(--theme-primary);
	}

	/* Touch screens have no hover, so the play mark is always shown. */
	@media (hover: none) {
		.clip-tile__play {
			opacity: 1;
			top: 0.7rem;
			left: auto;
			right: 0.7rem;
			width: 30px;
			height: 30px;
			margin: 0;
		}

		.clip-tile__play svg {
			width: 13px;
			height: 13px;
			margin-left: 2px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.clip-tile {
			transition: none;
		}

		.clip-tile:hover {
			transform: none;
		}
	}
</style>
