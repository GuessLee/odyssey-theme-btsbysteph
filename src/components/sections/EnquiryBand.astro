---
// The enquiry form as a page section, so "Check my date" is a jump on the
// same page rather than a trip to /company/contact. Anchor: #enquire.
import ContactForm from '../forms/ContactForm.astro';
---

<section class="enquiry-band" id="enquire">
	<div class="enquiry-band__grid">
		<div class="enquiry-band__copy">
			<span class="eyebrow">Check my date</span>
			<h2>Is your date still open?</h2>
			<p class="enquiry-band__lede">
				Tell me the date and the venue and I'll come back to you about
				availability and the package that fits.
			</p>
			<ol class="enquiry-band__steps">
				<li>Send the date and where you're getting married.</li>
				<li>We have a consultation call about your day.</li>
				<li>
					Your gallery, recap and reels arrive within 24-48 hours of the
					wedding.
				</li>
			</ol>
			<p class="enquiry-band__email">
				Prefer email? <a href="mailto:info@btsbs.com">info@btsbs.com</a>
			</p>
		</div>
		<div class="enquiry-band__form">
			<ContactForm />
		</div>
	</div>
</section>

<script>
	// The form arrives as a third-party iframe with no title; name it for screen readers.
	document.querySelectorAll('.enquiry-band__form').forEach(holder => {
		const nameFrames = () =>
			holder.querySelectorAll('iframe:not([title])').forEach(frame => {
				frame.title = 'Enquiry form';
			});
		nameFrames();
		new MutationObserver(nameFrames).observe(holder, {
			childList: true,
			subtree: true,
		});
	});
</script>

<style>
	.enquiry-band {
		background-color: var(--theme-surface-2);
		padding: var(--space-8) var(--space-4);
		/* Clear the sticky header when jumped to. */
		scroll-margin-top: var(--navbar-height);
	}

	.enquiry-band__grid {
		max-width: var(--container-max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		align-items: center;
		gap: var(--space-6);
	}

	.enquiry-band h2 {
		margin: 0.5rem 0 var(--space-2);
	}

	.enquiry-band__lede {
		font-family: var(--theme-font-family-serif);
		font-size: var(--font-size-md);
		font-style: italic;
		line-height: 1.5;
		opacity: 0.8;
		max-width: 44ch;
	}

	.enquiry-band__steps {
		list-style: none;
		margin: var(--space-3) 0;
		padding: 0;
		counter-reset: step;
	}

	.enquiry-band__steps li {
		counter-increment: step;
		position: relative;
		padding: 0.5rem 0 0.5rem 2.75rem;
		max-width: 48ch;
	}

	.enquiry-band__steps li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 0.45rem;
		width: 1.9rem;
		height: 1.9rem;
		border: 1.5px solid var(--theme-accent);
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-family: var(--theme-font-family-display);
		font-size: 0.95rem;
		color: var(--theme-accent-text);
	}

	.enquiry-band__email {
		margin: 0;
	}

	.enquiry-band__form {
		min-width: 0;
		padding: var(--space-3);
		background: #fff;
		border: 1px solid rgba(196, 164, 132, 0.25);
		border-radius: var(--theme-radius-lg);
		box-shadow: var(--theme-card-shadow);
	}

	@media (max-width: 900px) {
		.enquiry-band {
			padding: var(--space-6) var(--space-3);
		}

		.enquiry-band__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-4);
		}

		.enquiry-band__form {
			padding: var(--space-2);
		}
	}
</style>
