---
import {
	Container,
	TextCardSection,
} from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import NewsletterForm from '../../components/forms/NewsletterForm.astro';
import '@styles/blog-theme.css';

const seo = {
	title: 'Journal | BTS By Steph',
	description: 'The BTS By Steph journal is on its way — real wedding stories, behind-the-scenes videography tips, and what to expect on your day.',
};
---

<Layout {seo}>
	<div class="blog-warm-scope">
		<TextCardSection>
			<Container narrow>
				<span class="coming-soon__eyebrow">Coming Soon</span>
				<h1>The <em>Journal</em></h1>
				<p>
					Real wedding stories, behind-the-scenes videography tips, and what to
					expect on your day — the journal is in the works. Drop your email
					below and be the first to know when it goes live.
				</p>
				<NewsletterForm />
			</Container>
		</TextCardSection>
	</div>
</Layout>

<style>
	.coming-soon__eyebrow {
		display: inline-block;
		margin-bottom: 0.75rem;
		font-family: var(--theme-font-family-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--blog-highlight-deep);
	}
	.coming-soon__eyebrow::before {
		content: '';
		display: inline-block;
		width: 8px;
		height: 8px;
		margin-right: 0.5rem;
		border-radius: 50%;
		background: var(--blog-highlight);
		vertical-align: middle;
	}
	h1 em {
		font-style: normal;
		font-family: var(--blog-font-script);
		color: var(--blog-highlight-deep);
	}
</style>
