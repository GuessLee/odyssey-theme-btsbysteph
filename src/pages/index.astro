---
import { parse, isBefore } from 'date-fns';
import { Icon } from 'astro-icon/components';
import {
	AnnouncementBar,
	Button,
	Container,
	CustomerQuoteSection,
	ThreeColumnTextSection,
	CtaCardSection,
} from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'BTS By Steph | Wedding Content Creator',
	description: 'BTS By Steph | Wedding Content Creator',
	image: 'Bts.png'
};

const postModules = import.meta.glob('./blog/posts/*.mdx', { eager: true });
const journalPosts = Object.values(postModules)
	.map(({ frontmatter, url }) => ({
		title: frontmatter.title,
		excerpt: frontmatter.excerpt,
		featuredImage: frontmatter.featuredImage,
		publishDate: parse(frontmatter.publishDate, 'MMMM d, yyyy', new Date()),
		href: url,
	}))
	.sort((a, b) => (isBefore(a.publishDate, b.publishDate) ? 1 : -1))
	.slice(0, 2);
---

<AnnouncementBar
	text="Read Our Latest Journal Post"
	href="/blog/posts/welcome-to-the-journal/"
	slot="announcement-bar"
/>
<Layout {seo}>
	<style>
		/* ---- shared section rhythm ---- */
		.home-section {
			margin: 0 auto;
			padding: var(--space-8) var(--space-4);
		}

		.home-section--tinted {
			background-color: var(--theme-surface-1);
		}

		.home-section__head {
			text-align: center;
			max-width: 640px;
			margin: 0 auto var(--space-6);
		}

		.home-section__head h2 {
			margin: 0.5rem 0 0;
		}

		/* ---- hero ---- */
		.hero {
			padding: var(--space-8) var(--space-4) var(--space-7);
		}

		.hero__grid {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: 1.05fr 0.95fr;
			align-items: center;
			gap: var(--space-6);
		}

		.hero__lede {
			font-family: var(--theme-font-script);
			font-size: clamp(2.75rem, 5vw, 4rem);
			line-height: 0.9;
			color: var(--theme-accent-text);
			display: block;
			margin: 0.25rem 0 var(--space-3);
		}

		.hero h1 {
			margin: var(--space-2) 0 0;
			font-size: clamp(2.4rem, 4.4vw, 3.6rem);
		}

		.hero__sub {
			font-family: var(--theme-font-family-serif);
			font-size: 1.2rem;
			font-style: italic;
			color: var(--theme-on-bg);
			opacity: 0.75;
			max-width: 42ch;
			margin: 0 0 var(--space-5);
		}

		.hero__trust-row {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--space-4);
			margin-top: var(--space-6);
		}

		.hero__stat {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
		}

		.hero__stat strong {
			font-family: var(--theme-font-family-display);
			font-size: 1.6rem;
			font-weight: 600;
			color: var(--theme-primary);
		}

		.hero__stat span {
			font-size: 0.75rem;
			letter-spacing: 0.04em;
			color: var(--theme-on-bg);
			opacity: 0.65;
		}

		.hero__divider {
			width: 1px;
			height: 30px;
			background: rgba(196, 164, 132, 0.4);
		}

		.hero__image {
			position: relative;
			aspect-ratio: 4 / 5;
			border-radius: var(--theme-radius-lg);
			box-shadow: var(--theme-image-glow);
			overflow: hidden;
		}

		.hero__image::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(200deg, rgba(217, 165, 75, 0.32) 0%, transparent 45%);
			mix-blend-mode: multiply;
		}

		.hero__image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		@media (max-width: 900px) {
			.hero__grid {
				grid-template-columns: 1fr;
			}

			.hero__image {
				order: -1;
				max-width: 420px;
				margin: 0 auto;
			}
		}

		/* ---- about teaser ---- */
		.about-teaser__grid {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: 0.8fr 1.2fr;
			align-items: center;
			gap: var(--space-7);
		}

		.about-teaser__image {
			position: relative;
			aspect-ratio: 1 / 1;
			max-width: 420px;
			border-radius: var(--theme-radius-lg);
			box-shadow: var(--theme-image-glow);
			overflow: hidden;
		}

		.about-teaser__image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.about-teaser__body p {
			max-width: 56ch;
			opacity: 0.85;
		}

		.about-teaser__signature {
			font-family: var(--theme-font-script);
			font-size: 2.4rem;
			color: var(--theme-accent-text);
			margin-top: var(--space-2);
		}

		@media (max-width: 900px) {
			.about-teaser__grid {
				grid-template-columns: 1fr;
				text-align: center;
			}

			.about-teaser__image {
				margin: 0 auto;
			}

			.about-teaser__body p {
				margin-left: auto;
				margin-right: auto;
			}
		}

		/* ---- portfolio ---- */
		.video-container {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-4);
			justify-items: center;
		}

		.video-wrapper {
			position: relative;
			overflow: hidden;
			transition: transform var(--theme-transition);
		}

		.video-wrapper:hover {
			transform: translateY(-8px);
		}

		.video-container video {
			width: 100%;
			height: 500px;
			object-fit: cover;
			border-radius: var(--theme-radius-lg);
			box-shadow: var(--theme-image-glow);
			transition: box-shadow var(--theme-transition);
		}

		.video-wrapper:hover video {
			box-shadow: 0 20px 44px -14px rgba(181, 119, 46, 0.45);
		}

		@media (max-width: 1024px) {
			.video-container {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (max-width: 768px) {
			.video-container {
				grid-template-columns: 1fr;
				gap: var(--space-3);
			}

			.video-container video {
				height: 450px;
			}
		}

		/* ---- pricing ---- */
		.pricing-cards {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: var(--space-4);
			align-items: start;
		}

		.pricing-card {
			position: relative;
			background: var(--theme-surface-1);
			border: 1px solid rgba(196, 164, 132, 0.15);
			border-radius: var(--theme-radius-lg);
			padding: var(--space-5) var(--space-4);
			text-align: center;
			box-shadow: var(--theme-card-shadow);
			transition: transform var(--theme-transition), box-shadow var(--theme-transition);
		}

		.pricing-card:hover {
			transform: translateY(-10px);
			box-shadow: 0 20px 44px -14px rgba(26, 26, 26, 0.3);
		}

		.pricing-card.featured {
			background: var(--theme-primary);
			color: var(--theme-on-primary);
			transform: scale(1.05);
			box-shadow: 0 20px 44px -12px rgba(181, 119, 46, 0.35);
			z-index: 1;
		}

		.pricing-card.featured:hover {
			transform: scale(1.05) translateY(-10px);
			box-shadow: 0 28px 56px -14px rgba(181, 119, 46, 0.45);
		}

		.popular-badge {
			position: absolute;
			top: -14px;
			left: 50%;
			transform: translateX(-50%);
			background: var(--theme-accent);
			color: #fff;
			font-family: var(--theme-font-family-sans);
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			padding: 0.4rem 1.5rem;
			border-radius: var(--theme-button-border-radius);
		}

		.card-top {
			margin-bottom: var(--space-4);
			padding-bottom: var(--space-3);
			border-bottom: 1px solid rgba(196, 164, 132, 0.2);
		}

		.pricing-card.featured .card-top {
			border-bottom-color: rgba(255, 255, 255, 0.15);
		}

		.package-name {
			font-family: 'Italianno', cursive;
			font-size: 2.2rem;
			font-weight: 400;
			margin-bottom: 0.75rem;
		}

		.price {
			font-family: var(--theme-font-family-display);
			font-size: 3rem;
			font-weight: 600;
			line-height: 1;
			margin-bottom: 0.25rem;
		}

		.price-note {
			font-family: var(--theme-font-family-serif);
			font-size: 0.9rem;
			font-style: italic;
			opacity: 0.7;
		}

		.features {
			list-style: none;
			padding: 0;
			margin: 0 0 var(--space-4) 0;
			text-align: left;
		}

		.features li {
			font-family: var(--theme-font-family-sans);
			font-size: 0.95rem;
			padding: 0.6rem 0;
			border-bottom: 1px solid rgba(196, 164, 132, 0.1);
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.pricing-card.featured .features li {
			border-bottom-color: rgba(255, 255, 255, 0.08);
		}

		.features li::before {
			content: '✓';
			font-weight: 700;
			color: var(--theme-accent);
			flex-shrink: 0;
		}

		.pricing-card.featured .features li::before {
			color: var(--theme-accent);
		}

		.card-btn {
			display: inline-block;
			font-family: var(--theme-font-family-sans);
			font-size: 0.85rem;
			font-weight: 600;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			text-decoration: none;
			padding: 0.9rem 2.5rem;
			border: 2px solid var(--theme-accent);
			border-radius: var(--theme-button-border-radius);
			color: var(--theme-accent-text);
			background: transparent;
			transition: all var(--theme-transition);
		}

		.card-btn:hover {
			background: var(--theme-accent);
			color: #fff;
		}

		.pricing-card.featured .card-btn {
			border-color: var(--theme-accent);
			color: var(--theme-on-primary);
		}

		.pricing-card.featured .card-btn:hover {
			background: var(--theme-accent);
			color: #fff;
		}

		@media (max-width: 1024px) {
			.pricing-cards {
				grid-template-columns: 1fr;
				max-width: 420px;
				margin: 0 auto;
				gap: var(--space-5);
			}

			.pricing-card.featured {
				transform: scale(1);
			}

			.pricing-card.featured:hover {
				transform: translateY(-10px);
			}
		}

		/* ---- journal preview ---- */
		.journal-preview__head {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			max-width: var(--container-max-width);
			margin: 0 auto var(--space-6);
			text-align: left;
		}

		.journal-preview__head h2 {
			margin: 0.5rem 0 0;
		}

		.journal-grid {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
		}

		.journal-card {
			display: block;
			text-decoration: none;
			color: inherit;
		}

		.journal-card__image {
			aspect-ratio: 16 / 10;
			margin-bottom: var(--space-3);
			border-radius: var(--theme-radius-lg);
			box-shadow: var(--theme-image-glow);
			overflow: hidden;
		}

		.journal-card__image img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform var(--theme-transition-slow);
		}

		.journal-card:hover .journal-card__image img {
			transform: scale(1.045);
		}

		.journal-card h3 {
			margin: 0 0 0.5rem;
			font-size: var(--font-size-md);
		}

		.journal-card p {
			font-size: 0.95rem;
			opacity: 0.75;
			margin: 0 0 0.5rem;
		}

		.journal-card__read {
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--theme-accent-text);
		}

		@media (max-width: 768px) {
			.journal-preview__head {
				flex-direction: column;
				align-items: flex-start;
				gap: var(--space-3);
			}

			.journal-grid {
				grid-template-columns: 1fr;
			}
		}
	</style>

	<!-- Hero -->
	<section class="hero">
		<div class="hero__grid">
			<div>
				<span class="eyebrow">Wedding Content Creator</span>
				<h1>Relive the magic<span class="hero__lede">of your golden hour.</span></h1>
				<p class="hero__sub">
					Cinematic iPhone videography for South Florida weddings — authentic
					moments, timeless style, delivered while the day is still warm in
					your memory.
				</p>
				<Button href="/company/contact" customIcon
					>Message Me <Fragment slot="icon">
						<Icon name="ic:baseline-chevron-right" />
					</Fragment></Button
				>
				<div class="hero__trust-row">
					<div class="hero__stat"><strong>5+</strong><span>years in weddings</span></div>
					<div class="hero__divider"></div>
					<div class="hero__stat"><strong>24–48h</strong><span>turnaround</span></div>
					<div class="hero__divider"></div>
					<div class="hero__stat"><strong>100%</strong><span>iPhone-shot</span></div>
				</div>
			</div>
			<div class="hero__image">
				<img src="/assets/images/landing-1/osmoselfie.jpg" alt="Steph filming on location" />
			</div>
		</div>
	</section>

	<!-- Value Props -->
	<ThreeColumnTextSection>
		<div slot="column-1-body">
			<h2>Authentic Moments</h2>
			<p>
			  Dive into the genuine emotions and spontaneous moments of your special day with access to raw footage captured on an iPhone. Experience the authenticity firsthand.
			</p>
		  </div>
		<div slot="column-2-body">
			<h2>Behind The Scenes</h2>
			<p>
				Gain an intimate and authentic view of your wedding day through raw footage shot on an iPhone. It's akin to peering behind the curtain, revealing the real-life moments that made your day unforgettable.
			</p>
		</div>
		<div slot="column-3-body">
			<h2>Perfect Complement</h2>
			<p>
				While raw iPhone footage adds a distinctive touch, it harmoniously complements professional photography and videography. Together, we offer a comprehensive portrayal of your wedding day, blending authenticity with artistry.
			</p>
		</div>
	</ThreeColumnTextSection>

	<!-- About Teaser -->
	<section class="home-section">
		<div class="about-teaser__grid">
			<div class="about-teaser__image">
				<img src="/assets/images/home/steph.jpg" alt="Stephanie, BTS By Steph" />
			</div>
			<div class="about-teaser__body">
				<span class="eyebrow">Behind the Lens</span>
				<h2>Hi, I'm Stephanie</h2>
				<p>
					Master of Matrimony Media and your wedding day content creator — but
					you can call me Steph. With over 5 years of experience spanning
					general content creation and diverse roles within the wedding
					industry, I bring a wealth of expertise to intricately weave your
					unique love story with unparalleled style and sophistication.
				</p>
				<p>
					Born and raised under the sunny skies of Miami, with two daughters
					who keep me on my toes — Miami isn't just where I live, it's my
					muse, my playground, and my canvas.
				</p>
				<div class="about-teaser__signature">Steph</div>
				<div style="margin-top: var(--space-4)">
					<Button href="/company/about" outlined customIcon
						>More About Me <Fragment slot="icon">
							<Icon name="ic:baseline-chevron-right" />
						</Fragment></Button
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Portfolio Video Section -->
	<section class="home-section home-section--tinted">
		<div class="home-section__head">
			<span class="eyebrow">My Work</span>
			<h2>A glimpse into the magic I capture</h2>
		</div>
		<div class="video-container">
			<div class="video-wrapper">
				<video controls controlslist="nodownload" oncontextmenu="return false;">
					<source src="https://btsbs.s3.us-east-2.amazonaws.com/C9nBkdVRoJ5.mp4" type="video/mp4">
					Your browser does not support the video tag.
				</video>
			</div>

			<div class="video-wrapper">
				<video controls controlslist="nodownload" oncontextmenu="return false;">
					<source src="https://btsbs.s3.us-east-2.amazonaws.com/DGyZELqRdgY_fixed.mp4" type="video/mp4">
					Your browser does not support the video tag.
				</video>
			</div>

			<div class="video-wrapper">
				<video controls controlslist="nodownload" oncontextmenu="return false;">
					<source src="https://btsbs.s3.us-east-2.amazonaws.com/DGs9WgIRL0P_fixed.mp4" type="video/mp4">
					Your browser does not support the video tag.
				</video>
			</div>
		</div>
	</section>

	<!-- Wedding Packages -->
	<section class="home-section">
		<div class="home-section__head">
			<span class="eyebrow">Wedding Packages</span>
			<h2>Capture every moment of your special day</h2>
		</div>
		<div class="pricing-cards">
			<div class="pricing-card">
				<div class="card-top">
					<h3 class="package-name">Bridal Bliss</h3>
					<div class="price">$550</div>
					<span class="price-note">starting at</span>
				</div>
				<ul class="features">
					<li>4 hours of coverage</li>
					<li>1 consultation call</li>
					<li>Full wedding photo and video gallery</li>
					<li>Shot on the latest iPhone</li>
					<li>Delivered within 24-48 hours</li>
					<li>1 edited recap video</li>
					<li>1 reel or TikTok</li>
				</ul>
				<a href="/company/contact" class="card-btn">Get Started</a>
			</div>

			<div class="pricing-card featured">
				<div class="popular-badge">Most Popular</div>
				<div class="card-top">
					<h3 class="package-name">Tie The Knot</h3>
					<div class="price">$625</div>
					<span class="price-note">starting at</span>
				</div>
				<ul class="features">
					<li>8 hours of coverage</li>
					<li>1 consultation call</li>
					<li>Full wedding photo and video gallery</li>
					<li>Shot on the latest iPhone</li>
					<li>Delivered within 24-48 hours</li>
					<li>1 edited recap video</li>
					<li>3 reels or TikToks</li>
				</ul>
				<a href="/company/contact" class="card-btn">Get Started</a>
			</div>

			<div class="pricing-card">
				<div class="card-top">
					<h3 class="package-name">Love Story</h3>
					<div class="price">$700</div>
