					<li>Shot on the latest iPhone</li>
					<li>Delivered within 24-48 hours</li>
					<li>1 edited recap video</li>
				</ul>
				<a href="/company/contact" class="card-btn">Get Started</a>
			</div>

			<div class="pricing-card featured">
				<div class="popular-badge">Most Popular</div>
				<div class="card-top">
					<h3 class="package-name">Elevated Experience</h3>
					<div class="price">$395</div>
					<span class="price-note">starting at</span>
				</div>
				<ul class="features">
					<li>4 hours of coverage</li>
					<li>1 consultation call</li>
					<li>Full photo & video gallery</li>
					<li>Shot on the latest iPhone</li>
					<li>Delivered within 24-48 hours</li>
					<li>1 edited recap video</li>
					<li>1 reel or TikTok with trending audio</li>
				</ul>
				<a href="/company/contact" class="card-btn">Get Started</a>
			</div>

			<div class="pricing-card">
				<div class="card-top">
					<h3 class="package-name">Elite Spotlight</h3>
					<div class="price">$480</div>
					<span class="price-note">starting at</span>
				</div>
				<ul class="features">
					<li>6 hours of coverage</li>
					<li>1 consultation call</li>
					<li>Full photo & video gallery</li>
					<li>Shot on the latest iPhone</li>
					<li>Expedited delivery within 12-24 hours</li>
					<li>1 extended recap video</li>
					<li>2 reels or TikToks with trending audio</li>
				</ul>
				<a href="/company/contact" class="card-btn">Get Started</a>
			</div>
		</div>
	</section>

	<!-- Journal Preview -->
	<section class="home-section">
		<div class="journal-preview__head">
			<div>
				<span class="eyebrow">From the Journal</span>
				<h2>Real wedding stories, straight from the field</h2>
			</div>
			<Button href="/blog" outlined customIcon
				>Read the Journal <Fragment slot="icon">
					<Icon name="ic:baseline-chevron-right" />
				</Fragment></Button
			>
		</div>
		<div class="journal-grid">
			{journalPosts.map((post) => (
				<a class="journal-card" href={post.href}>
					<div class="journal-card__image">
						<img src={post.featuredImage} alt={post.title} />
					</div>
					<h3>{post.title}</h3>
					<p>{post.excerpt}</p>
					<span class="journal-card__read">Read the story →</span>
				</a>
			))}
		</div>
	</section>

	<CtaCardSection>
		<h2>Let's Create Magic Together</h2>
		<p>
			Ready to capture the authentic moments of your special day?
		</p>
		<Button href="/company/contact" onPrimary customIcon
			>Get In Touch <Fragment slot="icon">
				<Icon name="ic:baseline-chevron-right" />
			</Fragment></Button
		>
	</CtaCardSection>
</Layout>
