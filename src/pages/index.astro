					<li>Delivered within 24-48 hours</li>
					<li>1 edited recap video</li>
					<li>4 reels or TikToks</li>
				</ul>
				<a href="/company/contact" class="card-btn">Get Started</a>
			</div>
		</div>
	</section>

	<CustomerQuoteSection
		quoteText="She's amazing at capturing the perfect moments and putting them together."
		customerName="Samantha B."
	/>

	<!-- General Events Packages -->
	<section class="home-section home-section--tinted">
		<div class="home-section__head">
			<span class="eyebrow">General Events</span>
			<h2>From birthdays to corporate gatherings</h2>
		</div>
		<div class="pricing-cards">
			<div class="pricing-card">
				<div class="card-top">
					<h3 class="package-name">Essential Moments</h3>
					<div class="price">$275</div>
