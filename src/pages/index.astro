---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import {
	Button,
	ClipTile,
	ClipViewer,
	ClipWall,
	CustomerQuoteSection,
	EnquiryBand,
	PackageCards,
	StickyEnquireBar,
} from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import { heroTiles, homeWallTiles } from '@data/clips';
import { weddingPackages } from '@data/packages';
import stephFilming from '@assets/images/steph-filming.jpg';
---

<Layout enquireHref="#enquire">
	<style>
		/* ---- shared section rhythm ---- */
		.home-section {
			margin: 0 auto;
			padding: var(--space-8) var(--space-4);
			scroll-margin-top: var(--navbar-height);
		}

		.home-section__inner {
			max-width: var(--container-max-width);
			margin: 0 auto;
		}

		.home-section__head {
			text-align: center;
			max-width: 640px;
			margin: 0 auto var(--space-6);
		}

		.home-section__head h2 {
			margin: 0.5rem 0 0;
		}

		.home-section__head--split {
			display: flex;
			justify-content: space-between;
			align-items: flex-end;
			gap: var(--space-3);
			max-width: none;
			margin-bottom: var(--space-4);
			text-align: left;
		}

		.text-link {
			font-size: var(--font-size-sm);
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			text-decoration: none;
			white-space: nowrap;
			color: var(--theme-accent-text);
			border-bottom: 1.5px solid var(--theme-accent);
			padding-bottom: 2px;
		}

		/* ---- hero: the headline beside real footage ---- */
		.reel-hero {
			padding: var(--space-7) var(--space-4) var(--space-6);
			overflow: hidden;
		}

		.reel-hero__grid {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			align-items: center;
			gap: var(--space-6);
		}

		.reel-hero h1 {
			margin: var(--space-2) 0 var(--space-3);
			font-size: clamp(2.4rem, 4.2vw, 3.8rem);
		}

		.reel-hero__lede {
			font-family: var(--theme-font-script);
			font-size: 1.25em;
			line-height: 0.85;
			color: var(--theme-accent-text);
			display: block;
			margin-top: 0.1em;
		}

		.reel-hero__sub {
			font-family: var(--theme-font-family-serif);
			font-size: 1.25rem;
			font-style: italic;
			line-height: 1.55;
			opacity: 0.8;
			max-width: 36ch;
			margin: 0;
		}

		.reel-hero__cta {
			display: flex;
			flex-wrap: wrap;
			gap: var(--space-2);
			margin-top: var(--space-4);
		}

		.reel-hero__stats {
			display: grid;
			grid-template-columns: repeat(3, auto);
			justify-content: start;
			margin: var(--space-5) 0 0;
		}

		.reel-hero__stats div {
			padding: 0 var(--space-3);
			border-left: 1px solid rgba(196, 164, 132, 0.4);
		}

		.reel-hero__stats div:first-child {
			padding-left: 0;
			border-left: 0;
		}

		.reel-hero__stats dt {
			font-family: var(--theme-font-family-display);
			font-size: 1.6rem;
			font-weight: 600;
			line-height: 1.2;
			color: var(--theme-primary);
		}

		.reel-hero__stats dd {
			margin: 0;
			font-size: 0.8rem;
			letter-spacing: 0.04em;
		}

		/* Three clips fanned out; the first in the list sits in the middle. */
		.reel-hero__stack {
			display: grid;
			grid-template-columns: 1fr 1.28fr 1fr;
			align-items: center;
			max-width: 640px;
			justify-self: center;
			width: 100%;
		}

		.reel-hero__stack > :global(.clip-tile) {
			grid-row: 1;
		}

		.reel-hero__stack > :global(.clip-tile:nth-child(1)) {
			grid-column: 2;
			z-index: 2;
			box-shadow: 0 30px 60px -22px rgba(122, 77, 24, 0.6);
		}

		.reel-hero__stack > :global(.clip-tile:nth-child(2)) {
			grid-column: 1;
			transform: rotate(-4deg) translateX(14%);
		}

		.reel-hero__stack > :global(.clip-tile:nth-child(3)) {
			grid-column: 3;
			transform: rotate(4deg) translateX(-14%);
		}

		.reel-hero__stack > :global(.clip-tile:nth-child(4)) {
			display: none;
		}

		.reel-hero__stack > :global(.clip-tile:hover) {
			z-index: 3;
		}

		/* The lead clip shows its play mark and drifts slowly, so the first
		   screen feels alive without downloading any video. */
		.reel-hero__stack > :global(.clip-tile:nth-child(1) .clip-tile__play) {
			opacity: 1;
		}

		.reel-hero__stack > :global(.clip-tile:nth-child(1) img) {
			animation: reel-drift 14s ease-in-out infinite alternate;
		}

		@keyframes reel-drift {
			from {
				transform: scale(1);
			}
			to {
				transform: scale(1.08);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.reel-hero__stack > :global(.clip-tile:nth-child(1) img) {
				animation: none;
			}
		}

		/* ---- one-line promise strip ---- */
		.promise-strip {
			background-color: var(--theme-surface-1);
			border-top: 1px solid rgba(196, 164, 132, 0.35);
			border-bottom: 1px solid rgba(196, 164, 132, 0.35);
			padding: 0 var(--space-4);
		}

		.promise-strip__grid {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.promise-strip__item {
			padding: var(--space-3);
			border-left: 1px solid rgba(196, 164, 132, 0.35);
		}

		.promise-strip__item:first-child {
			padding-left: 0;
			border-left: 0;
		}

		.promise-strip__item h2 {
			font-size: var(--font-size-md);
			color: var(--theme-accent-text);
			margin: 0 0 0.25rem;
		}

		.promise-strip__item p {
			font-size: var(--font-size-sm);
			line-height: 1.6;
			margin: 0;
		}

		/* ---- reel wall ---- */
		.wall-more {
			display: flex;
			justify-content: center;
			margin-top: var(--space-5);
		}

		/* ---- packages ---- */
		.events-link {
			text-align: center;
			margin: var(--space-5) 0 0;
		}

		/* ---- about strip ---- */
		.about-teaser__grid {
			max-width: var(--container-max-width);
			margin: 0 auto;
			display: grid;
			grid-template-columns: 0.8fr 1.2fr;
			align-items: center;
			gap: var(--space-7);
		}

		.about-teaser__image {
			aspect-ratio: 4 / 5;
			max-width: 420px;
			border-radius: var(--theme-radius-lg);
			box-shadow: var(--theme-image-glow);
			overflow: hidden;
		}

		.about-teaser__image :global(img) {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: 62% 40%;
		}

		.about-teaser__body p {
			max-width: 56ch;
			opacity: 0.85;
		}

		.about-teaser__signature {
			font-family: var(--theme-font-script);
			font-size: 2.4rem;
			color: var(--theme-accent-text);
			margin-top: var(--space-2);
		}

		.about-teaser__cta {
			margin-top: var(--space-4);
		}

		@media (max-width: 900px) {
			.home-section {
				padding: var(--space-6) var(--space-3);
			}

			.home-section__head--split {
				flex-direction: column;
				align-items: flex-start;
			}

			.reel-hero {
				padding: var(--space-5) var(--space-3) var(--space-4);
			}

			.reel-hero__grid {
				grid-template-columns: minmax(0, 1fr);
				gap: var(--space-4);
			}

			.reel-hero__sub {
				font-size: 1.15rem;
				max-width: none;
			}

			.reel-hero__cta :global(.btn--outlined) {
				display: none;
			}

			.reel-hero__stats {
				display: none;
			}

			/* The fan becomes a swipe row, so footage is on the first screen. */
			.reel-hero__stack {
				display: flex;
				gap: 0.75rem;
				max-width: none;
				width: auto;
				justify-self: stretch;
				margin: 0 calc(var(--space-3) * -1);
				padding: 0.25rem var(--space-3) 1.5rem;
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				scroll-padding-left: var(--space-3);
				scrollbar-width: none;
			}

			.reel-hero__stack::-webkit-scrollbar {
				display: none;
			}

			.reel-hero__stack > :global(.clip-tile:nth-child(n)) {
				display: block;
				flex: none;
				width: 56%;
				transform: none;
				scroll-snap-align: start;
				box-shadow: var(--theme-image-glow);
			}

			.promise-strip {
				padding: 0 var(--space-3);
			}

			.promise-strip__grid {
				grid-template-columns: minmax(0, 1fr);
			}

			.promise-strip__item {
				padding: var(--space-2) 0;
				border-left: 0;
				border-top: 1px solid rgba(196, 164, 132, 0.35);
			}

			.promise-strip__item:first-child {
				border-top: 0;
			}

			.about-teaser__grid {
				grid-template-columns: minmax(0, 1fr);
				gap: var(--space-4);
				text-align: center;
			}

			.about-teaser__image {
				/* auto margins shrink a grid item to its content, which is 0 wide
				   until the lazy photo loads; a width reserves the box up front */
				width: 100%;
				max-width: 260px;
				margin: 0 auto;
			}

			.about-teaser__body p {
				margin-left: auto;
				margin-right: auto;
			}

			.about-teaser__cta {
				display: flex;
				justify-content: center;
			}
		}
	</style>

	<!-- Hero: footage on the first screen at every width -->
	<section class="reel-hero">
		<div class="reel-hero__grid">
			<div>
				<span class="eyebrow">Wedding Content Creator</span>
				<h1>
					Relive the magic<span class="reel-hero__lede"
						>of your golden hour.</span
					>
				</h1>
				<p class="reel-hero__sub">
					Cinematic iPhone videography for South Florida weddings. Authentic
					moments, timeless style, delivered while the day is still warm in your
					memory.
				</p>
				<div class="reel-hero__cta">
					<Button href="#enquire" customIcon
						>Check my date <Fragment slot="icon">
							<Icon name="ic:baseline-chevron-right" />
						</Fragment></Button
					>
					<Button href="#reels" outlined>Watch the reels</Button>
				</div>
				<dl class="reel-hero__stats">
					<div><dt>5+</dt><dd>years in weddings</dd></div>
					<div><dt>24-48h</dt><dd>turnaround</dd></div>
					<div><dt>100%</dt><dd>iPhone-shot</dd></div>
				</dl>
			</div>
			<div class="reel-hero__stack" data-clip-group>
				{
					heroTiles.map(tile => (
						<ClipTile
							tile={tile}
							caption={false}
							eager
							sizes="(max-width: 900px) 56vw, 260px"
						/>
					))
				}
			</div>
		</div>
	</section>

	<!-- What she offers, in one line each -->
	<section class="promise-strip" aria-label="What you get">
		<div class="promise-strip__grid">
			<div class="promise-strip__item">
				<h2>Authentic Moments</h2>
				<p>The real, unscripted parts of your day, straight from an iPhone.</p>
			</div>
			<div class="promise-strip__item">
				<h2>Behind The Scenes</h2>
				<p>A behind-the-curtain view of the day you spent so long planning.</p>
			</div>
			<div class="promise-strip__item">
				<h2>Perfect Complement</h2>
				<p>
					Works alongside your photographer and videographer, not instead of
					them.
				</p>
			</div>
		</div>
	</section>

	<!-- The reel wall: the portfolio is the home page -->
	<section class="home-section" id="reels">
		<div class="home-section__inner">
			<div class="home-section__head home-section__head--split">
				<div>
					<span class="eyebrow">The Reel Wall</span>
					<h2>Real weddings, straight from my phone</h2>
				</div>
				<a class="text-link" href="/reels">Open the full library</a>
			</div>
			<ClipWall tiles={homeWallTiles} />
			<div class="wall-more">
				<Button href="/reels" outlined customIcon
					>See every moment <Fragment slot="icon">
						<Icon name="ic:baseline-chevron-right" />
					</Fragment></Button
				>
			</div>
		</div>
	</section>

	<!-- Wedding packages -->
	<section class="home-section" id="packages">
		<div class="home-section__head">
			<span class="eyebrow">Wedding Packages</span>
			<h2>Capture every moment of your special day</h2>
		</div>
		<PackageCards packages={weddingPackages} ctaHref="#enquire" />
		<p class="events-link">
			Planning a birthday or a corporate gathering?
			<a class="text-link" href="/events">See events packages</a>
		</p>
	</section>

	<CustomerQuoteSection
		quoteText="She's amazing at capturing the perfect moments and putting them together."
		customerName="Samantha B."
	/>

	<!-- About strip -->
	<section class="home-section" id="about">
		<div class="about-teaser__grid">
			<div class="about-teaser__image">
				<Image
					src={stephFilming}
					alt="Steph filming on location with her phone on a gimbal"
					widths={[420, 840]}
					sizes="(max-width: 900px) 260px, 420px"
				/>
			</div>
			<div class="about-teaser__body">
				<span class="eyebrow">Behind the Lens</span>
				<h2>Hi, I'm Stephanie</h2>
				<p>
					Your wedding day content creator - but you can call me Steph. I
					follow your day with an iPhone and hand back the candid,
					behind-the-scenes moments within 24-48 hours, while it all still
					feels like yesterday.
				</p>
				<p>
					I'm Miami born and raised, with 5+ years across content creation
					and the wedding industry behind me. You enjoy the day, I'll make
					sure you get to relive it.
				</p>
				<div class="about-teaser__signature">Steph</div>
				<div class="about-teaser__cta">
					<Button href="/company/about" outlined customIcon
						>More About Me <Fragment slot="icon">
							<Icon name="ic:baseline-chevron-right" />
						</Fragment></Button
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Enquiry: the form lives on the home page -->
	<EnquiryBand />

	<ClipViewer enquireHref="#enquire" />
	<StickyEnquireBar />
</Layout>
